# Modelo de configuração LOCAL. Copie para backend/.env e ajuste.
# (o iniciar.bat faz essa cópia sozinho na primeira vez)
# Na VPS estas mesmas variáveis ficam na stack do Portainer — veja docker-compose.yml.

# Chave para assinar os logins. Use 32+ caracteres aleatórios.
SECRET_KEY=troque-esta-chave-por-uma-sequencia-aleatoria-longa
# Tempo que o login dura sem precisar entrar de novo (minutos). 600 = 10 horas.
TOKEN_EXPIRA_MINUTOS=600
# Arquivo do banco SQLite (relativo à pasta backend/).
DATABASE_PATH=../dados/gestaoaxia.db
# Administrador criado automaticamente no primeiro start (se ainda não existir).
ADMIN_EMAIL=admin@exemplo.com
ADMIN_SENHA=troque-esta-senha
ADMIN_NOME=Administrador
# Origens liberadas para chamar a API de outro endereço (vazio = só o próprio site).
CORS_ORIGINS=http://localhost:5173
# Pasta do React compilado. Vazio = não servir o frontend (o iniciar.bat preenche).
FRONTEND_DIST=

# Endereco publico da API usado pelas telas. Vazio = mesmo endereco das telas (/api).
API_URL=
